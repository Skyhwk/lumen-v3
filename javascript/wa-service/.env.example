# Server
PORT=5010
NODE_ENV=development

# Lumen API (validasi token ERP)
LUMEN_API_URL=http://localhost/lumen-v3/public/api

# Database (shared dengan Lumen .env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
GROUP_MESSAGE_RETENTION_DAYS=14
WA_ENABLE_MESSAGE_HISTORY_SYNC=false

# Storage
SESSIONS_DIR=./sessions
MEDIA_DIR=./media

# CORS (React frontend dev server)
CORS_ORIGIN=http://localhost:3000

# Nama device di WhatsApp linked devices
WA_DEVICE_NAME=INTILAB SUPER APPS
