# ── Server ──────────────────────────────────────────────
PORT=5010
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Lumen API (auth token validation) ───────────────────
LUMEN_API_URL=http://localhost:8000

# ── Database ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

# ── WhatsApp session & media ────────────────────────────
SESSIONS_DIR=./sessions
MEDIA_DIR=./media
WA_DEVICE_NAME=INTILAB SUPER APPS
WA_DEVICE_PLATFORM=appropriate
WA_ENABLE_MESSAGE_HISTORY_SYNC=
WA_AUTO_DOWNLOAD_MEDIA=
GROUP_MESSAGE_RETENTION_DAYS=3
WA_AVATAR_TTL_HOURS=24

# ── MQTT (realtime push — ganti Socket.IO) ──────────────
MQTT_HOST=apps.intilab.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_BROKER_URL=mqtt://user:pass@apps.intilab.com:1883
WA_MQTT_TOPIC_PREFIX=/intilab/wa
WA_MQTT_CLIENT_ID=wa-service-publisher
WA_MQTT_RECONNECT_MS=5000
